// --- MIX 3: SEQUENZA DI BOOT (Cinematic Boot) ---
const BootSequenceMix = ({ project }) => {
  
  const BootModule = ({ feature, index }) => {
    const [ref, isVisible] = useScrollReveal({ threshold: 0.4 });
    
    return (
      <div ref={ref} className="relative min-h-[400px] py-12">
        <div className={`font-mono text-xl md:text-2xl text-emerald-500 flex items-center gap-4 transition-all duration-700 absolute top-12 left-0
          ${isVisible ? 'opacity-0 -translate-y-8 pointer-events-none' : 'opacity-100 translate-y-0'}`}>
          <span>❯</span> systemctl start module_{feature.id}.service...
          <span className="w-3 h-6 bg-emerald-500 animate-pulse inline-block"></span>
        </div>

        <div className={`transition-all duration-1000 delay-300 origin-top
          ${isVisible ? 'opacity-100 scale-100 translate-y-0' : 'opacity-0 scale-95 translate-y-12 pointer-events-none'}`}>
          
          <div className="flex flex-col xl:flex-row bg-zinc-900/40 border border-zinc-800/60 rounded-3xl overflow-hidden shadow-2xl backdrop-blur-sm">
            
            <div className="xl:w-1/2 relative min-h-[300px]">
              <img src={feature.image} alt={feature.title} className="absolute inset-0 w-full h-full object-cover opacity-80" />
              <div className="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent p-8 flex flex-col justify-end">
                <h3 className="text-3xl font-bold text-white mb-2">{feature.title}</h3>
                <p className="text-zinc-300">{feature.visualDesc}</p>
              </div>
            </div>

            <div className="xl:w-1/2 p-8 lg:p-12 bg-zinc-950 flex flex-col justify-center font-mono">
               <div className="flex items-center gap-3 text-zinc-500 mb-8 border-b border-zinc-800 pb-4">
                 <PlayCircle size={20} className="text-emerald-500" />
                 <span>Process: <span className="text-white">{feature.terminalTitle}</span></span>
                 <span className="ml-auto px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-full text-xs border border-emerald-500/20">{feature.tech}</span>
               </div>
               
               <pre className="text-sm text-zinc-400 overflow-x-auto whitespace-pre-wrap leading-relaxed">
                 <code dangerouslySetInnerHTML={{
                    __html: feature.code
                      .replace(/({|})/g, '<span class="text-zinc-600">$1</span>')
                  }} />
               </pre>
            </div>
          </div>
        </div>
      </div>
    );
  };

  return (
    <div className="max-w-5xl mx-auto space-y-12 py-16">
      <div className="font-mono text-zinc-500 mb-16 text-center">
        $ ./run_showcase.sh --target="Nova Ecosystem"
      </div>
      
      {project.features.map((feat, idx) => (
        <BootModule key={feat.id} feature={feat} index={idx} />
      ))}
      
      <div className="font-mono text-zinc-500 mt-24 text-center animate-pulse">
        [ Process completed. System idle. ]
      </div>
    </div>
  );
};


// --- MAIN APP COMPONENT ---
export default function App() {
  const [activeLayout, setActiveLayout] = useState('staggered'); // Impostato di default sulla nuova vista

  return (
    <div className="min-h-screen bg-[#050505] text-zinc-50 p-4 md:p-8 font-sans selection:bg-emerald-500/30 overflow-x-hidden">
      
      <div className="max-w-6xl mx-auto mb-16 mt-8 space-y-8">
        <div>
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-sm mb-6 font-mono">
            <Code2 size={14} /> Showcase: Cinematic + Terminal Mix
          </div>
          <h1 className="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
            Design <span className="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-500">Ibrido</span> per Ingegneri.
          </h1>
          <p className="text-zinc-400 max-w-2xl text-lg">
            Scegli come combinare l'impatto visivo di un prodotto finito con la cruda bellezza del codice sorgente che lo fa funzionare.
          </p>
        </div>

        <div className="flex flex-wrap gap-2 bg-zinc-900/50 p-2 rounded-2xl w-fit border border-zinc-800 backdrop-blur-md">
          {[
            { id: 'symbiotic', icon: <ChevronRight size={18}/>, label: '1. Sticky Sync' },
            { id: 'staggered', icon: <GitCommit size={18}/>, label: '2. Staggered Terminal' }, // Tab Aggiornata
            { id: 'boot', icon: <Terminal size={18}/>, label: '3. Boot Sequence' }
          ].map(layout => (
            <button
              key={layout.id}
              onClick={() => setActiveLayout(layout.id)}
              className={`flex items-center gap-2 px-6 py-3 rounded-xl font-medium transition-all duration-300 ${
                activeLayout === layout.id 
                  ? 'bg-emerald-500 text-zinc-950 shadow-lg' 
                  : 'text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200'
              }`}
            >
              {layout.icon} {layout.label}
            </button>
          ))}
        </div>
      </div>

      <main className="max-w-6xl mx-auto pb-32">
        <div className="relative w-full">
          {activeLayout === 'symbiotic' && (
            <div className="animate-in fade-in slide-in-from-bottom-8 duration-700">
               <SymbioticTerminal project={showcaseProject} />
            </div>
          )}
          
          {activeLayout === 'staggered' && (
            <div className="animate-in fade-in zoom-in-95 duration-700">
              <StaggeredTerminalMix project={showcaseProject} />
            </div>
          )}
          
          {activeLayout === 'boot' && (
            <div className="animate-in fade-in slide-in-from-bottom-12 duration-1000">
              <BootSequenceMix project={showcaseProject} />
            </div>
          )}
        </div>
      </main>

    </div>
  );
}