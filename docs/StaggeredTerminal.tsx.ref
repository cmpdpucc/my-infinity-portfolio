// --- COMPONENTE SUPPORTO: TERMINALE ANIMATO REALISTICO ---
const AnimatedTerminal = ({ feature, isVisible }) => {
  const [step, setStep] = useState(0); // 0: idle, 1: typing, 2: loading, 3: code revealed, 4: interactive CLI
  const [typedText, setTypedText] = useState("");
  const [interaction, setInteraction] = useState({ status: 'idle', command: null, output: null });
  const fullCommand = "> executing module load...";
  const bottomRef = useRef(null);

  useEffect(() => {
    if (!isVisible || step !== 0) return;
    
    setStep(1);
    let i = 0;
    const typingInterval = setInterval(() => {
      setTypedText(fullCommand.slice(0, i + 1));
      i++;
      if (i >= fullCommand.length) {
        clearInterval(typingInterval);
        setTimeout(() => setStep(2), 400); 
        setTimeout(() => {
          setStep(3);
          // Rende il terminale interattivo dopo un breve ritardo
          setTimeout(() => {
            setStep(4);
            scrollToBottom();
          }, 800);
        }, 900);
      }
    }, 40);

    return () => clearInterval(typingInterval);
  }, [isVisible, step]);

  const scrollToBottom = () => {
    if (bottomRef.current) {
      bottomRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  };

  // Gestore dei comandi interattivi
  const handleCommand = (cmd) => {
    setInteraction({ status: 'typing', command: cmd.name, output: null });
    scrollToBottom();
    
    setTimeout(() => {
      setInteraction({ status: 'running', command: cmd.name, output: null });
      setTimeout(() => {
        setInteraction({ status: 'done', command: cmd.name, output: cmd.output });
        scrollToBottom();
      }, 800); // Tempo di "elaborazione" simulato
    }, 400); // Tempo di "digitazione" simulato
  };

  return (
    <div className="w-full max-w-lg bg-[#0f111a] rounded-xl border border-zinc-800/50 shadow-2xl flex flex-col h-[400px] overflow-hidden transition-transform duration-700 ease-out hover:shadow-emerald-500/5 hover:-translate-y-1">
      {/* Terminal Header macOS Style */}
      <div className="h-12 bg-[#161b22] border-b border-zinc-800/50 flex items-center px-4 relative shrink-0">
        <div className="flex gap-2 absolute left-4">
          <div className="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
          <div className="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
          <div className="w-3 h-3 rounded-full bg-[#27c93f]"></div>
        </div>
        <div className="w-full text-center text-xs text-zinc-500 font-mono flex items-center justify-center gap-2">
          <span>&gt;_</span> {feature.terminalTitle}
        </div>
      </div>

      {/* Terminal Body */}
      <div className="p-6 flex-1 overflow-y-auto font-mono text-sm relative custom-terminal-scroll flex flex-col">
        
        {/* riga di esecuzione e tag */}
        <div className="flex justify-between items-center mb-6 h-8 shrink-0">
          <div className="text-zinc-500 flex items-center gap-2">
            <span className="text-emerald-500 font-bold">
              {typedText}
              {step < 3 && <span className="w-2 h-4 bg-emerald-500 inline-block animate-pulse ml-1 align-middle"></span>}
            </span>
          </div>
          <div className={`transition-opacity duration-500 ${step >= 1 ? 'opacity-100' : 'opacity-0'} px-3 py-1 bg-[#1a2028] text-emerald-400 rounded-md text-xs border border-zinc-700/50`}>
            {feature.tech}
          </div>
        </div>
        
        {/* Codice renderizzato post-caricamento */}
        <div className={`transition-all duration-500 origin-top shrink-0 ${step >= 3 ? 'opacity-100 scale-100 blur-none' : 'opacity-0 scale-95 blur-sm'}`}>
          <pre className="text-zinc-300 whitespace-pre-wrap leading-loose">
            <code dangerouslySetInnerHTML={{
              __html: feature.code
                .replace(/(struct|var|const|let|async|fn|return|match|import|from)/g, '<span class="text-pink-500 font-medium">$1</span>')
                .replace(/(View|String|Result|Error|Request|Response|Float32Array|ScrollView|LazyVStack|ForEach)/g, '<span class="text-yellow-300">$1</span>')
                .replace(/(@StateObject)/g, '<span class="text-zinc-400">$1</span>')
            }} />
          </pre>
        </div>

        {/* --- SEZIONE INTERATTIVA (CLI) --- */}
        <div className={`mt-6 pt-6 border-t border-zinc-800/50 transition-all duration-700 shrink-0 ${step >= 4 ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4 pointer-events-none hidden'}`}>
          
          {interaction.status === 'idle' && (
            <div className="flex flex-col gap-3">
              <div className="flex items-center gap-2 text-zinc-500 text-xs">
                <span className="text-emerald-500 font-bold">❯</span> Interactive shell ready.
                <span className="w-1.5 h-3 bg-zinc-500 inline-block animate-pulse"></span>
              </div>
              <div className="flex flex-wrap gap-2">
                {feature.commands?.map(cmd => (
                  <button 
                    key={cmd.name} 
                    onClick={() => handleCommand(cmd)} 
                    className="text-xs font-mono px-3 py-1.5 bg-[#161b22] hover:bg-zinc-800 text-emerald-400/80 hover:text-emerald-400 rounded-md border border-zinc-800 hover:border-emerald-500/50 transition-all cursor-pointer shadow-sm hover:shadow-emerald-500/10 active:scale-95"
                  >
                    ./{cmd.name.toLowerCase().replace(' ', '_')}.sh
                  </button>
                ))}
              </div>
            </div>
          )}

          {interaction.status === 'typing' && (
             <div className="text-zinc-300 flex items-center gap-2 text-xs">
               <span className="text-emerald-500 font-bold">❯</span> ./{interaction.command.toLowerCase().replace(' ', '_')}.sh
               <span className="w-1.5 h-3 bg-zinc-400 inline-block animate-pulse"></span>
             </div>
          )}

          {interaction.status === 'running' && (
             <div className="flex flex-col gap-1 text-xs">
               <div className="text-zinc-400 flex items-center gap-2">
                 <span className="text-emerald-500 font-bold">❯</span> ./{interaction.command.toLowerCase().replace(' ', '_')}.sh
               </div>
               <div className="text-zinc-500 pl-4 mt-2">Executing sequence... <span className="animate-pulse">⠋</span></div>
             </div>
          )}

          {interaction.status === 'done' && (
             <div className="text-xs">
               <div className="text-zinc-500 flex items-center gap-2 mb-3">
                 <span className="text-emerald-500 font-bold">❯</span> ./{interaction.command.toLowerCase().replace(' ', '_')}.sh
               </div>
               <div className="text-emerald-400 bg-[#0a0c10] border border-emerald-900/50 p-3 rounded-md text-xs inline-block shadow-inner w-full">
                 {interaction.output}
               </div>
               <button onClick={() => setInteraction({status: 'idle'})} className="block mt-4 text-zinc-600 hover:text-zinc-400 transition-colors cursor-pointer text-[10px] uppercase tracking-wider">
                 [ Clear Terminal ]
               </button>
             </div>
          )}
        </div>
        
        {/* Anchor point per lo scroll automatico */}
        <div ref={bottomRef} className="h-4 shrink-0"></div>

      </div>
    </div>
  );
};

// --- MIX 1: IL TERMINALE SIMBIOTICO (Sticky Sync) ---
const SymbioticTerminal = ({ project }) => {
  const [activeIdx, setActiveIdx] = useState(0);

  const FeatureBlock = ({ feature, index }) => {
    const [ref, isVisible] = useScrollReveal({ threshold: 0.5 });
    
    useEffect(() => {
      if (isVisible) setActiveIdx(index);
    }, [isVisible, index]);

    return (
      <div ref={ref} className="min-h-[80vh] flex flex-col justify-center py-16 transition-opacity duration-700">
        <div className="flex items-center gap-3 text-emerald-400 mb-4 font-mono text-sm">
          {feature.category === 'Mobile Native' ? <Smartphone size={16}/> : feature.category === 'Web Platform' ? <Globe size={16}/> : <Cpu size={16}/>}
          {feature.category}
        </div>
        <h3 className="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">{feature.title}</h3>
        <p className="text-zinc-400 text-lg mb-8 max-w-lg leading-relaxed">{feature.visualDesc}</p>
        <div className="rounded-3xl overflow-hidden border border-zinc-800 shadow-2xl relative group">
          <div className="absolute inset-0 bg-emerald-500/10 opacity-0 group-hover:opacity-100 transition-opacity z-10 mix-blend-overlay" />
          <img src={feature.image} alt={feature.title} className="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-1000" />
        </div>
      </div>
    );
  };

  return (
    <div className="flex flex-col lg:flex-row gap-16 relative">
      <div className="lg:w-1/2">
        <div className="pt-8 pb-32">
          <h2 className="text-5xl font-extrabold mb-4">{project.title}</h2>
          <p className="text-xl text-zinc-500">{project.tagline}</p>
        </div>
        {project.features.map((feat, idx) => (
          <FeatureBlock key={feat.id} feature={feat} index={idx} />
        ))}
      </div>

      <div className="hidden lg:block lg:w-1/2 relative">
        <div className="sticky top-24 h-[600px] w-full bg-[#0d1117] rounded-3xl border border-zinc-800 shadow-[0_0_50px_rgba(0,0,0,0.5)] flex flex-col overflow-hidden">
          <div className="h-14 bg-[#161b22] border-b border-zinc-800 flex items-center px-4 justify-between">
            <div className="flex gap-2">
              <div className="w-3.5 h-3.5 rounded-full bg-[#ff5f56]"></div>
              <div className="w-3.5 h-3.5 rounded-full bg-[#ffbd2e]"></div>
              <div className="w-3.5 h-3.5 rounded-full bg-[#27c93f]"></div>
            </div>
            <div className="text-xs text-zinc-500 font-mono flex items-center gap-2">
               <Terminal size={14} /> {project.features[activeIdx].terminalTitle}
            </div>
            <div className="w-10"></div> 
          </div>
          
          <div className="p-8 font-mono text-sm h-full relative overflow-y-auto">
            <div className="absolute top-8 right-8 px-3 py-1 bg-zinc-800/80 text-emerald-400 rounded text-xs border border-zinc-700/50 backdrop-blur-sm shadow-lg">
              {project.features[activeIdx].tech}
            </div>
            
            <div className="text-zinc-500 mb-6 flex items-center gap-2">
               <span className="text-emerald-500">❯</span> executing module load...
            </div>
            
            <pre className="text-zinc-300 whitespace-pre-wrap animate-in fade-in slide-in-from-bottom-4 duration-500" key={activeIdx}>
              <code className="text-sm leading-loose" dangerouslySetInnerHTML={{
                __html: project.features[activeIdx].code
                  .replace(/(struct|var|const|let|async|fn|return|match|import|from)/g, '<span class="text-pink-500">$1</span>')
                  .replace(/(View|String|Result|Error|Request|Response|Float32Array|ScrollView|LazyVStack|ForEach)/g, '<span class="text-yellow-300">$1</span>')
                  .replace(/(@StateObject)/g, '<span class="text-zinc-400">$1</span>')
              }} />
            </pre>
            
            <div className="mt-8 flex items-center gap-2 text-zinc-500 animate-pulse">
              <span className="w-2.5 h-5 bg-emerald-500 inline-block"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

